[user]
	name = Seth Lewis
	email = slewis@clickup.com

[includeIf "gitdir:~/Documents/personal-projs/"]
	path = ~/.gitconfig-personal
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = OneHalfDark
	hyperlinks = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[push]
	default = current
[pull]
	ff = only
[fetch]
	prune = true
[rebase]
	autosquash = true
[rerere]
	enabled = true
[init]
	defaultBranch = main
[column]
	ui = auto
[branch]
	sort = -committerdate
