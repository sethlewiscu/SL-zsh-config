# ~/.zshrc — thin loader. Real config lives in ~/.config/zsh/*.zsh
# Edit modules with:  zshconf      Reload with:  zshreload
# Full command reference:  cheat
# ---------------------------------------------------------------

# --- Powerlevel10k instant prompt (must stay at the very top) ---
# Renders the prompt before the rest of the config finishes loading,
# so the shell feels instant even while plugins initialize.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

zstyle ':omz:update' mode reminder
zstyle ':omz:update' frequency 14

plugins=(
  git                           # git aliases + completion
  gh                            # GitHub CLI completion
  zsh-completions               # extra completion definitions
  zsh-autosuggestions           # grey ghost-text from history
  zsh-history-substring-search  # ↑/↓ searches matching history
  zsh-syntax-highlighting       # MUST be last of the highlighting group
)

# Autosuggestion appearance + behavior
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

source "$ZSH/oh-my-zsh.sh"

# --- Local modules, in numeric order ---
for _mod in "$HOME"/.config/zsh/*.zsh(N); do
  source "$_mod"
done
unset _mod

# --- Prompt config (generated by `p10k configure`) ---
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# --- Machine-local overrides, never version-controlled ---
# Put secrets and machine-specific settings in ~/.zshrc.local
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
